# Server Port (auto-assigned by Render/Heroku/Railway in production)
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated if multiple, e.g. https://yourportfolio.netlify.app)
ALLOWED_ORIGIN=http://localhost:5173

# Frontend API URL (for Vite build when hosting frontend and backend on separate domains)
# Leave empty for same-origin or local dev proxy; set to your deployed backend URL in production
# VITE_API_URL=https://your-portfolio-api.onrender.com

# ==================================================
# CONTACT EMAIL CONFIGURATION (Nodemailer / Gmail)
# ==================================================
# To receive real contact messages in your inbox:
# 1. Go to your Google Account (myaccount.google.com)
# 2. Navigate to: Security -> 2-Step Verification -> App Passwords
# 3. Create an App Password named "Portfolio"
# 4. Copy the generated 16-character password and paste below
# 5. Never commit this file or your password to GitHub (protected by .gitignore)

EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_TO=mayank.bhadauns@gmail.com
